 "captions": [
  {
   "start": 0.03,
   "end": 1.02,
   "text": "This river flows"
  },
  {
   "start": 1.02,
   "end": 2.63,
   "text": "in two directions."
  },
  {
   "start": 3.24,
   "end": 3.92,
   "text": "The Hudson River"
  },
  {
   "start": 3.92,
   "end": 4.74,
   "text": "runs from New"
  },
  {
   "start": 4.74,
   "end": 5.78,
   "text": "York's Adirondack"
  },
  {
   "start": 5.78,
   "end": 6.22,
   "text": "Mountains"
  },
  {
   "start": 6.22,
   "end": 7.08,
   "text": "down to New"
  },
  {
   "start": 7.08,
   "end": 8.26,
   "text": "York City."
  },
  {
   "start": 8.26,
   "end": 8.82,
   "text": "But its lower"
  },
  {
   "start": 8.82,
   "end": 9.82,
   "text": "half isn't just"
  },
  {
   "start": 9.82,
   "end": 10.83,
   "text": "a river."
  },
  {
   "start": 10.83,
   "end": 12.16,
   "text": "It's an estuary,"
  },
  {
   "start": 12.16,
   "end": 12.8,
   "text": "an arm of"
  },
  {
   "start": 12.8,
   "end": 13.88,
   "text": "the sea."
  },
  {
   "start": 13.88,
   "end": 14.84,
   "text": "Twice a day,"
  },
  {
   "start": 14.84,
   "end": 15.88,
   "text": "ocean tides push"
  },
  {
   "start": 15.88,
   "end": 16.54,
   "text": "in from New"
  },
  {
   "start": 16.54,
   "end": 17.46,
   "text": "York Harbor and"
  },
  {
   "start": 17.46,
   "end": 19.09,
   "text": "reverse the current."
  },
  {
   "start": 19.09,
   "end": 19.94,
   "text": "That tide reaches"
  },
  {
   "start": 19.94,
   "end": 20.67,
   "text": "about a hundred"
  },
  {
   "start": 20.67,
   "end": 21.08,
   "text": "and fifty"
  },
  {
   "start": 21.08,
   "end": 22.66,
   "text": "miles upstream,"
  },
  {
   "start": 22.66,
   "end": 23.18,
   "text": "all the way"
  },
  {
   "start": 23.18,
   "end": 23.74,
   "text": "to the dam"
  },
  {
   "start": 23.74,
   "end": 24.5,
   "text": "at Troy,"
  },
  {
   "start": 24.5,
   "end": 25.73,
   "text": "near Albany."
  },
  {
   "start": 25.73,
   "end": 27.04,
   "text": "In dry summers,"
  },
  {
   "start": 27.04,
   "end": 27.98,
   "text": "salty ocean water"
  },
  {
   "start": 27.98,
   "end": 28.76,
   "text": "can push about"
  },
  {
   "start": 28.76,
   "end": 29.98,
   "text": "sixty miles up"
  },
  {
   "start": 29.98,
   "end": 31.14,
   "text": "the river."
  },
  {
   "start": 31.14,
   "end": 31.84,
   "text": "Native peoples knew"
  },
  {
   "start": 31.84,
   "end": 32.9,
   "text": "this long before"
  },
  {
   "start": 32.9,
   "end": 34.68,
   "text": "Europeans arrived."
  },
  {
   "start": 34.68,
   "end": 35.46,
   "text": "One Native name"
  },
  {
   "start": 35.46,
   "end": 36.02,
   "text": "for the river"
  },
  {
   "start": 36.02,
   "end": 37.2,
   "text": "is often translated"
  },
  {
   "start": 37.2,
   "end": 38.4,
   "text": "as \"the river"
  },
  {
   "start": 38.4,
   "end": 39.04,
   "text": "that flows"
  },
  {
   "start": 39.04,
   "end": 40.458,
   "text": "both ways.\""
  }
 ],
