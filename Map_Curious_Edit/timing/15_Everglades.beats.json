 "captions": [
  {
   "start": 0.0,
   "end": 1.26,
   "text": "The Everglades isn't"
  },
  {
   "start": 1.26,
   "end": 2.88,
   "text": "really a swamp."
  },
  {
   "start": 2.88,
   "end": 3.89,
   "text": "It's a river."
  },
  {
   "start": 4.48,
   "end": 5.32,
   "text": "Water spills south"
  },
  {
   "start": 5.32,
   "end": 6.56,
   "text": "from Lake Okeechobee"
  },
  {
   "start": 6.56,
   "end": 7.48,
   "text": "and spreads into"
  },
  {
   "start": 7.48,
   "end": 8.46,
   "text": "a shallow sheet"
  },
  {
   "start": 8.46,
   "end": 9.1,
   "text": "up to about"
  },
  {
   "start": 9.1,
   "end": 11.09,
   "text": "sixty miles wide."
  },
  {
   "start": 11.09,
   "end": 11.86,
   "text": "It creeps toward"
  },
  {
   "start": 11.86,
   "end": 13.0,
   "text": "Florida Bay so"
  },
  {
   "start": 13.0,
   "end": 14.12,
   "text": "slowly you can"
  },
  {
   "start": 14.12,
   "end": 14.88,
   "text": "barely see"
  },
  {
   "start": 14.88,
   "end": 15.9,
   "text": "it move,"
  },
  {
   "start": 15.9,
   "end": 16.36,
   "text": "flowing through"
  },
  {
   "start": 16.36,
   "end": 18.09,
   "text": "tall sawgrass."
  },
  {
   "start": 18.09,
   "end": 18.8,
   "text": "That's why writer"
  },
  {
   "start": 18.8,
   "end": 19.7,
   "text": "Marjory Stoneman"
  },
  {
   "start": 19.7,
   "end": 20.1,
   "text": "Douglas"
  },
  {
   "start": 20.1,
   "end": 20.94,
   "text": "called it the"
  },
  {
   "start": 20.94,
   "end": 21.9,
   "text": "River of Grass"
  },
  {
   "start": 21.9,
   "end": 23.7,
   "text": "in 1947,"
  },
  {
   "start": 23.7,
   "end": 24.28,
   "text": "the same year"
  },
  {
   "start": 24.28,
   "end": 25.54,
   "text": "Everglades National Park"
  },
  {
   "start": 25.54,
   "end": 26.59,
   "text": "was dedicated."
  },
  {
   "start": 26.94,
   "end": 27.98,
   "text": "But canals,"
  },
  {
   "start": 27.98,
   "end": 29.0,
   "text": "farms and cities"
  },
  {
   "start": 29.0,
   "end": 30.02,
   "text": "have drained much"
  },
  {
   "start": 30.02,
   "end": 31.0,
   "text": "of it."
  },
  {
   "start": 31.0,
   "end": 31.56,
   "text": "Today"
  },
  {
   "start": 31.56,
   "end": 32.34,
   "text": "the Everglades is"
  },
  {
   "start": 32.34,
   "end": 33.34,
   "text": "about half its"
  },
  {
   "start": 33.34,
   "end": 34.53,
   "text": "original size."
  },
  {
   "start": 34.94,
   "end": 35.48,
   "text": "Now,"
  },
  {
   "start": 35.48,
   "end": 35.88,
   "text": "one of the"
  },
  {
   "start": 35.88,
   "end": 36.88,
   "text": "largest restoration"
  },
  {
   "start": 36.88,
   "end": 37.48,
   "text": "projects"
  },
  {
   "start": 37.48,
   "end": 38.2,
   "text": "in the world"
  },
  {
   "start": 38.2,
   "end": 39.1,
   "text": "is trying to"
  },
  {
   "start": 39.1,
   "end": 39.8,
   "text": "send that water"
  },
  {
   "start": 39.8,
   "end": 40.917,
   "text": "south again."
  }
 ],
