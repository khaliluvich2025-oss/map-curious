 "captions": [
  {
   "start": 0.04,
   "end": 0.88,
   "text": "The deepest lake"
  },
  {
   "start": 0.88,
   "end": 1.92,
   "text": "in America sits"
  },
  {
   "start": 1.92,
   "end": 3.04,
   "text": "inside a volcano"
  },
  {
   "start": 3.04,
   "end": 4.39,
   "text": "that collapsed."
  },
  {
   "start": 4.8,
   "end": 6.26,
   "text": "It's Crater Lake,"
  },
  {
   "start": 6.26,
   "end": 6.74,
   "text": "high in the"
  },
  {
   "start": 6.74,
   "end": 7.84,
   "text": "Cascade Mountains of"
  },
  {
   "start": 7.84,
   "end": 9.2,
   "text": "southern Oregon."
  },
  {
   "start": 9.2,
   "end": 9.82,
   "text": "About seventy-seven"
  },
  {
   "start": 9.82,
   "end": 10.28,
   "text": "hundred"
  },
  {
   "start": 10.28,
   "end": 11.48,
   "text": "years ago,"
  },
  {
   "start": 11.48,
   "end": 12.72,
   "text": "a towering volcano"
  },
  {
   "start": 12.72,
   "end": 13.4,
   "text": "called Mount"
  },
  {
   "start": 13.4,
   "end": 15.18,
   "text": "Mazama erupted."
  },
  {
   "start": 15.18,
   "end": 15.94,
   "text": "It blasted out"
  },
  {
   "start": 15.94,
   "end": 16.9,
   "text": "so much ash"
  },
  {
   "start": 16.9,
   "end": 17.94,
   "text": "and magma that"
  },
  {
   "start": 17.94,
   "end": 18.5,
   "text": "the top of"
  },
  {
   "start": 18.5,
   "end": 19.26,
   "text": "the mountain fell"
  },
  {
   "start": 19.26,
   "end": 20.49,
   "text": "in on itself,"
  },
  {
   "start": 20.49,
   "end": 21.32,
   "text": "leaving a giant"
  },
  {
   "start": 21.32,
   "end": 22.1,
   "text": "bowl called"
  },
  {
   "start": 22.1,
   "end": 23.47,
   "text": "a caldera."
  },
  {
   "start": 23.47,
   "end": 24.68,
   "text": "Over the centuries,"
  },
  {
   "start": 24.68,
   "end": 25.64,
   "text": "rain and snow"
  },
  {
   "start": 25.64,
   "end": 27.31,
   "text": "slowly filled it."
  },
  {
   "start": 27.31,
   "end": 27.78,
   "text": "No rivers"
  },
  {
   "start": 27.78,
   "end": 28.4,
   "text": "flow in,"
  },
  {
   "start": 28.4,
   "end": 29.08,
   "text": "and none"
  },
  {
   "start": 29.08,
   "end": 30.28,
   "text": "flow out."
  },
  {
   "start": 30.28,
   "end": 31.08,
   "text": "Today the lake"
  },
  {
   "start": 31.08,
   "end": 31.93,
   "text": "is about nineteen"
  },
  {
   "start": 31.93,
   "end": 33.54,
   "text": "hundred feet deep,"
  },
  {
   "start": 33.54,
   "end": 34.36,
   "text": "the deepest in"
  },
  {
   "start": 34.36,
   "end": 35.8,
   "text": "the United States."
  },
  {
   "start": 35.8,
   "end": 36.5,
   "text": "And because almost"
  },
  {
   "start": 36.5,
   "end": 37.16,
   "text": "all of its"
  },
  {
   "start": 37.16,
   "end": 38.22,
   "text": "water falls straight"
  },
  {
   "start": 38.22,
   "end": 39.48,
   "text": "from the sky,"
  },
  {
   "start": 39.48,
   "end": 39.9,
   "text": "it's one of"
  },
  {
   "start": 39.9,
   "end": 41.0,
   "text": "the clearest,"
  },
  {
   "start": 41.0,
   "end": 41.56,
   "text": "bluest lakes"
  },
  {
   "start": 41.56,
   "end": 42.542,
   "text": "on Earth."
  }
